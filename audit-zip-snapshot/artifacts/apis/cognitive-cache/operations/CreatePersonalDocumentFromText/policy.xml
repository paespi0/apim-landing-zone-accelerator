<policies>
	<inbound>
		<base />
		<choose>
			<when condition="@(!((Jwt)context.Variables["jwt"]).Claims["roles"].Contains("Personal.Contribute"))">
				<return-response>
					<set-status code="401" reason="Unauthorized" />
				</return-response>
			</when>
		</choose>
		<set-query-parameter name="security_groups" exists-action="override">
			<value>@(((Jwt)context.Variables["jwt"]).Claims["oid"].FirstOrDefault())</value>
		</set-query-parameter>
		<rewrite-uri template="/documents/from_text?document_id={document_id}&amp;title={title}&amp;category={category}&amp;source_url={source_url}&amp;owner={owner}" />
	</inbound>
	<backend>
		<base />
	</backend>
	<outbound>
		<base />
	</outbound>
	<on-error>
		<base />
	</on-error>
</policies>