<policies>
	<inbound>
		<base />
		<choose>
			<when condition="@(!((Jwt)context.Variables["jwt"]).Claims["roles"].Contains("Document.Manage"))">
				<return-response>
					<set-status code="401" reason="Unauthorized" />
				</return-response>
			</when>
		</choose>
	</inbound>
	<backend>
		<base />
	</backend>
	<outbound>
		<base />
	</outbound>
	<on-error>
		<base />
	</on-error>
</policies>